# Local npm start — copy to .env in this directory.
# For Coolify / docker compose, use the root .env.example (single source of truth).

########################
# Application
########################
PORT=3002
HOST=0.0.0.0

########################
# Supabase
########################
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

########################
# SMTP
########################
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-account@gmail.com
SMTP_PASS=your-gmail-app-password

########################
# Reporting
########################
# Optional From address (defaults to SMTP_USER).
# EMAIL_FROM=reports@yourdomain.com
#
# Do NOT set REPORT_RECIPIENT_EMAIL or SUPER_ADMIN_EMAIL.

########################
# Attendance finalization
########################
# Disabled by default. Use observe first; active requires the shared
# INTERNAL_API_SECRET and a company app_settings attendance_rules_v1_enabled flag.
ATTENDANCE_FINALIZER_ENABLED=false
ATTENDANCE_FINALIZER_MODE=observe
AUTH_SERVICE_URL=http://localhost:3001
# Required in production and must match api-gateway/auth-service.
INTERNAL_API_SECRET=
