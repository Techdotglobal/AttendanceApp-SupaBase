# Local npm start — copy to .env in this directory.
# For Coolify / docker compose, use the root .env.example (single source of truth).

########################
# Application
########################
PORT=3001
HOST=0.0.0.0

########################
# Supabase
########################
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

########################
# Company Onboarding
########################
# Required after the first company exists (X-Onboarding-Key header).
COMPANY_ONBOARDING_SECRET=

########################
# Internal service auth
########################
# Must match the api-gateway and reporting-service INTERNAL_API_SECRET. In
# production, X-User-Context is
# only trusted from requests carrying this secret (stamped by the gateway) or
# accompanied by a valid Supabase bearer token. Local non-production only may
# omit it for legacy compatibility.
INTERNAL_API_SECRET=
